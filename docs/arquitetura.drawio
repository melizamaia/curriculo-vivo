          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="aprovado" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="b2" target="comp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="severidade" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="comp" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="válido" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="b3" target="b4">
