        <!-- Front e BFF -->
        <mxCell id="front" value="&lt;b&gt;Front Next.js&lt;/b&gt; (web/)&lt;br&gt;radar do coordenador&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;:5173 · React + TypeScript&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="260" height="80" as="geometry" />
