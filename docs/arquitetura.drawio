        <mxCell id="retriever" value="&lt;b&gt;Retriever&lt;/b&gt;&lt;br&gt;TF-IDF + cosseno, filtro por tema&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;índice em memória por processo · versao_indice = hash do conteúdo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="api">
