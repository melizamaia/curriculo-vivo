  <diagram id="analise" name="Caminho de uma análise">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="&lt;b&gt;Caminho de uma análise&lt;/b&gt;: alerta só com citação, ou abstenção explícita" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="obj" value="Objeto de aprendizagem&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;POST /v1/analises ou varredura do radar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;Barreira 1&lt;/b&gt;&lt;br&gt;Escopo" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="145" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="busca" value="Busca por tema&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;TF-IDF, top_k=3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="160" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;Barreira 2&lt;/b&gt;&lt;br&gt;Confiança e&lt;br&gt;proveniência" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="comp" value="Compara datas&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;referência mais nova do material&lt;br&gt;× evidência vigente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="810" y="160" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;Barreira 3&lt;/b&gt;&lt;br&gt;Validação&lt;br&gt;do achado" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1030" y="140" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;Barreira 4&lt;/b&gt;&lt;br&gt;Alertas&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;não bloqueia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="160" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="&lt;b&gt;Resposta&lt;/b&gt;&lt;br&gt;defasagem_detectada&lt;br&gt;ou sem_achado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1400" y="160" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Abstenções -->
        <mxCell id="abs1" value="&lt;b&gt;abstido&lt;/b&gt;&lt;br&gt;objeto_invalido&lt;br&gt;material_sem_referencia&lt;br&gt;fora_de_escopo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="235" y="320" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="abs2" value="&lt;b&gt;abstido&lt;/b&gt;&lt;br&gt;evidencia_insuficiente&lt;br&gt;fonte_nao_validada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="320" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="abs3" value="&lt;b&gt;abstido&lt;/b&gt;&lt;br&gt;alerta_descartado&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;regressão no gerador,&lt;br&gt;nunca vira sem_achado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="320" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;Auditoria&lt;/b&gt; (Mongo ou memória)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;request_id, status, motivo, evidências citadas, versao_indice, latência · material só como hash&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1340" y="300" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Notas -->
        <mxCell id="n1" value="&lt;b&gt;Barreira 1&lt;/b&gt;: sem trechos; sem referência com ano; pede dose individualizada, documento médico, ou menciona paciente/aluno identificado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Barreira 2&lt;/b&gt;: similaridade abaixo do limiar (0,18); com EXIGIR_FONTE_OFICIAL, só orgao_oficial e diretriz_sociedade sustentam alerta. Literatura revisada isolada não dispara alerta.&lt;br&gt;&lt;br&gt;&lt;b&gt;Barreira 3&lt;/b&gt;: o alerta precisa citar evidência existente, com marcador válido, publicada depois de 31/12 do ano da referência do material.&lt;br&gt;&lt;br&gt;&lt;b&gt;Barreira 4&lt;/b&gt;: anexa avisos (base ilustrativa, confiança no limiar, objeto sem revisão há 3 anos)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sev" value="&lt;b&gt;Tabela de severidade&lt;/b&gt; (gap em meses; fronteiras com &amp;gt;=)&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;alta&lt;/th&gt;&lt;th&gt;média&lt;/th&gt;&lt;th&gt;baixa&lt;/th&gt;&lt;th&gt;sem achado&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;practice-changing&lt;/td&gt;&lt;td&gt;≥ 24&lt;/td&gt;&lt;td&gt;12–23&lt;/td&gt;&lt;td&gt;1–11&lt;/td&gt;&lt;td&gt;não posterior&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sem practice-changing&lt;/td&gt;&lt;td&gt;nunca&lt;/td&gt;&lt;td&gt;≥ 36&lt;/td&gt;&lt;td&gt;12–35&lt;/td&gt;&lt;td&gt;&amp;lt; 12&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Objeto com vários temas: uma defasagem por tema; vale a severidade máxima.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="470" width="520" height="170" as="geometry" />
        </mxCell>

