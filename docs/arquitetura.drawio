  <diagram id="arquitetura" name="Arquitetura">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="&lt;b&gt;Currículo Vivo&lt;/b&gt; · radar de defasagem curricular&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Corpus sintético (exemplo_ilustrativo: true). Mongo e Kafka são opcionais: sem eles, a API sobe em memória.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
