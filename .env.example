# Currículo Vivo — exemplo de configuração.
# Nenhuma variável é obrigatória: o serviço sobe com todos os fallbacks
# (sem Mongo, sem Kafka, sem chave de LLM) e registra no log em que modo entrou.

# --- Detecção -------------------------------------------------------------
LIMIAR_CONFIANCA=0.18
TOP_K=3
EXIGIR_FONTE_OFICIAL=true

# --- Tabela de severidade (seção 6 do PRD) --------------------------------
GAP_MESES_ALTA=24
GAP_MESES_MEDIA=12
GAP_MESES_MINIMO_SEM_PC=12
GAP_MESES_MEDIA_SEM_PC=36
ALERTA_REVISAO_OBJETO_DIAS=1095

# --- Dados ----------------------------------------------------------------
CAMINHO_EVIDENCIAS=data/evidencias/base_curada.json
CAMINHO_MATERIAL=data/material/catalogo.json

# --- Auditoria (cai para memória se indisponível) -------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=curriculo_vivo

# --- Mensageria (worker de ingestão) --------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ingestor-curriculo
KAFKA_TOPIC_EVIDENCIA_NOVA=evidencia.nova
KAFKA_TOPIC_EVIDENCIA_INDEXADA=evidencia.indexada
KAFKA_TOPIC_DEFASAGEM=defasagem.detectada

# --- Síntese da justificativa ---------------------------------------------
# Vazio = justificativa extrativa (padrão da demo, sem rede e sem custo).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
CUSTO_POR_1K_TOKENS=0.015
